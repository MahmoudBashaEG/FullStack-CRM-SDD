{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Crm.Api",
    "Audience": "Crm.Web",
    "AccessTokenLifetime": "00:10:00",
    "RefreshTokenLifetime": "7.00:00:00",
    "RefreshTokenReuseGracePeriod": "00:00:30"
  },
  "SlaAutomation": {
    "Enabled": true,
    "PollInterval": "00:01:00"
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.1-flash-lite",
    "Timeout": "00:00:30",
    "MaxOutputTokens": 1024,
    "Temperature": 0.3
  },
  "Ai": {
    "RequestsPerUserPerMinute": 6,
    "MaxChatMessages": 10,
    "MaxChatHistoryCharacters": 16000,
    "MaxTicketContextCharacters": 4000,
    "ActivityEntries": 8,
    "MaxKnowledgeSources": 3,
    "KnowledgeExcerptCharacters": 800
  },
  "Bootstrap": {
    "SuperAdmin": {
      "Email": "admin@admin.com",
      "FirstName": "System",
      "LastName": "Administrator"
    }
  }
}
